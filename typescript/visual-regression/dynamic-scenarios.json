      "operation": { "kind": "hold-element", "button": "left", "expectedDuringHold": { "position": 0 }, "expectedAfterRelease": { "position": 1 } },
      "frames": { "F0": { "steps": 0 }, "F1": { "steps": 0 }, "F2": { "after": "pointerdown" }, "F3": { "steps": 1, "while": "pointerdown" }, "F4": { "after": "pointerup", "steps": 10 }, "F5": { "steps": 100 } }
