{
  "name": "circuitjs1-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native TypeScript port of CircuitJS1",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "migration:report": "node scripts/migration-report.mjs",
    "compatibility:report": "node scripts/compatibility-report.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "visual:install-browser": "playwright install chromium",
    "visual:regression": "node visual-regression/run.mjs",
    "visual:smoke": "node visual-regression/run.mjs --limit=1",
    "visual:gate": "node visual-regression/run.mjs --strict",
    "desktop:install": "npm install --prefix desktop",
    "desktop:dev": "npm run dev --prefix desktop",
    "desktop:build": "npm run build --prefix desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "5.4.19",
    "vitest": "2.1.9"
  }
}
